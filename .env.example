
# NASA API Endpoints
APOD_API_URL=https://science.nasa.gov/wp-json/wp/v2/apod-basic
NASA_LIBRARY_API_URL=https://images-api.nasa.gov

# Database Configuration
DATABASE_PATH=data/nasa.db

# API Request Settings
REQUEST_TIMEOUT=20

# Database URL (optional). Overrides DATABASE_PATH, e.g. Postgres in Docker:
# DATABASE_URL=postgresql+psycopg2://nasa:nasa@postgres:5432/nasa

# Pipeline scope (Airflow DAG)
APOD_START_DATE=2020-01-01
LIBRARY_KEYWORDS=mars,jupiter,galaxy,nebula
LIBRARY_YEAR_START=2020
LIBRARY_YEAR_END=2026
LIBRARY_MAX_PAGES=2
# 1 = replay tests/fixtures instead of calling NASA (no network needed)
NASA_OFFLINE=0
