
# NASA API Endpoints
APOD_API_URL=https://science.nasa.gov/wp-json/wp/v2/apod-basic
NASA_LIBRARY_API_URL=https://images-api.nasa.gov

# API Request Settings
REQUEST_TIMEOUT=20

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Docker Compose ignores this and always connects to its own local postgres
# service. Set it only to run code outside Docker, e.g. a local Postgres:
#   DATABASE_URL=postgresql+psycopg2://nasa:nasa@localhost:5433/nasa
# The cloud database (Neon) URL is a secret: share it privately, never commit it.
DATABASE_URL=

# Local PostgreSQL started by docker compose
POSTGRES_USER=nasa
POSTGRES_PASSWORD=nasa
POSTGRES_DB=nasa
POSTGRES_HOST_PORT=5433

# Airflow web UI login (local only)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Pipeline scope (Airflow DAG)
# ---------------------------------------------------------------------------
# First run backfills APOD from this date; later runs fetch only new days.
APOD_START_DATE=2020-01-01
# The nine topics the team collects.
LIBRARY_KEYWORDS=mercury,venus,earth,mars,jupiter,saturn,uranus,neptune,galaxy
# Blank = all years.
LIBRARY_YEAR_START=
LIBRARY_YEAR_END=
# Pages of 100 results per topic per run (the full backfill is up to 100).
LIBRARY_MAX_PAGES=2
# 1 = replay tests/fixtures instead of calling NASA (no network needed)
NASA_OFFLINE=0
